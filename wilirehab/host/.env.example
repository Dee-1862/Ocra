# Copy this file to ".env" (same folder) and fill it in. ".env" is git-ignored: never commit it,
# never paste it into a chat, a paper or a screenshot.

# Supabase: Project Settings -> API. Use the ANON (public) key, never the service_role key.
# Leave both empty to run without a database: rounds then only queue in agents_queue.jsonl.
SUPABASE_URL=
SUPABASE_KEY=

# How often the hand and face agents save a snapshot to their tables, in seconds (default 5).
# 1 = every reading, for research. Larger = less data, and less of the sensitive face stream.
WILIREHAB_SAMPLE_S=5

# ONLY for reading data back (supabase_pull), and ONLY on a trusted machine such as the Pi:
# the service_role key. Leave this empty on the laptop that plays the games.
SUPABASE_SERVICE_KEY=

# A pseudonymous code for whoever is playing (P001, P002, ...). Not a name.
WILIREHAB_PARTICIPANT=P001

# Any long random phrase. It decides the agents' identities. Treat it like a password.
WILIREHAB_SEED=

# The address other machines use to reach the agents. Leave empty for this computer only
# (http://127.0.0.1:8000/submit). For the Pi on the same Wi-Fi, use this laptop's address,
# e.g. http://192.168.1.20:8000/submit
WILIREHAB_ENDPOINT=

# Addresses (agent1q...) of OTHER agents the orchestrator should listen to, comma separated
WILIREHAB_ALLOWED_SENDERS=

# Only for agent_test_client (and a Pi agent later): the gateway's address (agent1q...), from
# the "Gateway ..." line printed by agent_gateway.
WILIREHAB_GATEWAY_ADDRESS=

# Optional: the local port the games use to reach the agents program (default 47800).
# WILIREHAB_AGENT_PORT=47800
